# ============================================================
# Supabase configuration — copy to `.env` and fill in.
# ============================================================
# This file documents every value the project needs. Nothing here is loaded
# automatically by the frontend (the anon key is hardcoded in JS/main.js, which
# is safe — RLS enforces access). These are for the Supabase CLI and the
# send-meeting-email Edge Function.

# ── Project (CLI: `supabase link --project-ref $SUPABASE_PROJECT_REF`) ───────
SUPABASE_PROJECT_REF=xrzwjwaaayeoizmabchj
SUPABASE_URL=https://xrzwjwaaayeoizmabchj.supabase.co
# Public anon key — safe to expose; this is the value in JS/main.js.
SUPABASE_ANON_KEY=sb_publishable_QznNbgBFWibdv6eDosc2jQ_ZjwJMu8g
# Service-role key — SECRET. Never commit or ship to the browser.
# Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Edge Function secrets (Dashboard → Edge Functions → Secrets) ─────────────
# Set with: supabase secrets set RESEND_API_KEY=... RECIPIENT_EMAIL=... FROM_EMAIL=...
RESEND_API_KEY=
RECIPIENT_EMAIL=io@petra.ac.id
# Must be a verified sender/domain in Resend (resend.com → Domains).
FROM_EMAIL=PCU Global <noreply@yourdomain.com>
